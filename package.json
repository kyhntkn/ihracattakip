{
  "name": "ihracat-takip",
  "version": "1.0.0",
  "description": "Ihracat Takip Adres Defteri Masaustu Uygulamasi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.ihracat.takip",
    "productName": "Ihracat Takip",
    "files": ["main.js", "preload.js", "index.html", "lib/*.js", "build/icon.ico"],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
